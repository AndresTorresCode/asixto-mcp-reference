# Puerto del servidor MCP.
PORT=8080

# Tokens válidos, separados por coma. El Gateway de Asixto presenta uno de estos como
# `Authorization: Bearer …`.
#
# VACÍO = endpoint SIN autenticación. Solo para el primer arranque y el Inspector: la
# certificación exige 401 sin credencial.
#
# Genere uno con: openssl rand -hex 32
# Mantenga DOS activos durante una rotación para no cortar el servicio.
ASIXTO_TOKENS=
